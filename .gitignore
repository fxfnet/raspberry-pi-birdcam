# Captured images
captures/*
!captures/.gitkeep

# Downloaded AI models (easily re-fetched, no need to version)
model/*
!model/.gitkeep

# Custom-trained species model (not re-downloadable, must be versioned)
!model/garden_birds.onnx
!model/garden_birds_labels.csv

# Python cache
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/

# Logs
*.log

# OS/editor files
.DS_Store
*.swp
*.swo

# Local config
.env

# Camera test snapshot (regenerated on demand from the admin UI)
camera_test.jpg
camera_test.json

gallery/thumbs

# Training dataset and intermediate checkpoint (only the final garden_birds.onnx is versioned)
# training/model_captures.pth is versioned: base checkpoint for the next fine-tune (train.py --init)
dataset/
training/model_best.pth
training/model_best.json
