[Unit]
Description=Birdcam Admin Gallery
After=network.target

[Service]
User=fxf
WorkingDirectory=/home/fxf/birdcam/gallery
ExecStart=/usr/bin/python3 /home/fxf/birdcam/gallery/app.py
Restart=always
RestartSec=5
Environment=PORT=5001
Environment=BIRDCAM_ADMIN=1

[Install]
WantedBy=multi-user.target
