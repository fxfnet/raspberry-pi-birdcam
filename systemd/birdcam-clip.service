[Unit]
Description=Birdcam clip of the next motion (one shot, started from the admin gallery)
After=network.target birdcam.service
# Les deux se disputent la caméra : démarrer l'un arrête l'autre. Un restart de birdcam
# (minuterie de 03:00, déploiement) annule donc le clip au lieu de boucler en échec.
Conflicts=birdcam.service

[Service]
Type=simple
User=fxf
ExecStart=/usr/bin/python3 /home/fxf/birdcam/scripts/record_next_motion.py
TimeoutStopSec=30
# Arrêt de birdcam (jusqu'à 90 s) + attente maximale du script (3600 s) + préchauffage + clip + marge : borne un gel de la caméra.
RuntimeMaxSec=3900
# Quelle que soit la sortie (SIGKILL, gel, plantage), la capture photo repart.
# Le préfixe + exécute la commande en root, sans sudo.
ExecStopPost=+/usr/bin/systemctl start --no-block birdcam.service
