[Unit]
Description=Birdcam clip of the next motion (one shot, started from the admin gallery)
After=network.target

[Service]
Type=simple
User=fxf
ExecStart=/usr/bin/python3 /home/fxf/birdcam/scripts/record_next_motion.py
TimeoutStopSec=30
# Attente maximale du script (3600 s) + préchauffage + clip + marge : borne un gel de la caméra.
RuntimeMaxSec=3720
# Quelle que soit la sortie (SIGKILL, gel, plantage), la capture photo repart.
# Le préfixe + exécute la commande en root, sans sudo.
ExecStopPost=+/usr/bin/systemctl start --no-block birdcam.service
